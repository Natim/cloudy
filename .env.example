# Copy to .env and fill in values. Never commit .env.
# DJANGO_DEBUG=true is required for local development (production defaults to false).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
STRIPE_API_KEY=
STRIPE_FIRST_CLASS_SUBSCRIPTION=
STRIPE_WEBHOOK_SECRET=
DATABASE_URL=postgres://cloudy:cloudypwd@localhost:5432/cloudy_scratch
GOOGLE_ANALYTICS_PROPERTY_ID=
GAUGES_SITE_ID=
IMPORT_DEFAULT_OWNER_EMAIL=
# Leave EMAIL_HOST empty to print emails to the runserver console.
# EMAIL_HOST=in.mailjet.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
